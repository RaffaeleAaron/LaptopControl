[Unit]
Description=Laptop Control tray and virtual camera
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 "@HELPER@" --service --gui "@GUI@"
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
RuntimeDirectory=laptop-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=default.target
